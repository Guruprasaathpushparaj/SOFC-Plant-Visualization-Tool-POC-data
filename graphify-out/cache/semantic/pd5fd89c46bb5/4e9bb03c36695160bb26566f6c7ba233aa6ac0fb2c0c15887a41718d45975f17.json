{"nodes": [{"id": "05_twin_2d_readme_sofc_plant_twin", "label": "SOFC Plant Twin (2D, local)", "file_type": "document", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_app", "label": "app.js", "file_type": "code", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_style", "label": "style.css", "file_type": "code", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_data_sensors", "label": "data/sensors.js", "file_type": "code", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_data_bends", "label": "data/bends.js", "file_type": "code", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_start", "label": "start.bat", "file_type": "code", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_readme_stack_heat_balance", "label": "Stack heat balance model", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dT/dt = k(air/6000)^1.5 (Tin-T) + heaters + fuel + current - loss; one balance in every stage, fitted on 39 days with 8 replay stretches held out (mean error 56 -> 17.5 C)."}, {"id": "05_twin_2d_readme_recuperator_model", "label": "Recuperator air-in model (e 0.88 -> 0.83)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tin = 25 + e(T-25); stack balance keeps old formula (REC_PHYS=false) because lagged version made 9000-air cooling replay worse (74 -> 156 C)."}, {"id": "05_twin_2d_readme_eaph_air_heater_model", "label": "EAPH air heater readings model", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outlet TIRC 2.06 = air-in, inlet TIR 2.05 lagged recuperator + NG term; power = air cp dT / 0.89; power miss 1.42 -> 0.66 kW."}, {"id": "05_twin_2d_readme_air_in_target_hold", "label": "Air-in held at target in fuel switch / part load", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plant keeps air heater on and TWV-CA mixes bypass air, so air-in follows target (580/600 C) not max(recuperator,target); 10 part-load runs 4.2 C miss."}, {"id": "05_twin_2d_readme_stack_safety_trip_720", "label": "Stack safety trip at 720 C (TIRZ 8.1.3)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TIRZ 8.1.3 no longer capped at plant p98 so the lamp follows twin stack; trips like the plant."}, {"id": "05_twin_2d_readme_stage_rules", "label": "Twin stage rules (trip only from HS/PL, PL always to HS)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User decision 2026-11-04: trip purge only from hot standby or part load; after purge back to hot standby; part load always followed by hot standby."}, {"id": "05_twin_2d_readme_display_names", "label": "Display names (Trip / Emergency purge)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Display-only rename; data key stays 'Trip: purge'."}, {"id": "05_twin_2d_readme_stack_keeper", "label": "Stack keeper 660 C (twin only)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raises cathode air then lowers air-heater target above 660 C; not in plant data; keeper off trips after ~1.3 h."}, {"id": "05_twin_2d_readme_bend_panel", "label": "Last stage change bend/jerk panel", "file_type": "concept", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_readme_sensor_stage_fits", "label": "Per-stage linear sensor fits vs stack temperature", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used where R2 >= 0.25 else stage median, clipped to p2-p98; what the plant typically showed, not physics."}, {"id": "05_twin_2d_readme_min_jerk_sensor_easing", "label": "Minimum-jerk sensor easing at stage changes", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slow sensors blend old->new stage line on S-curve with plant delay/duration; leave-one-border-out error 19.9 -> 13.3 %."}, {"id": "05_twin_2d_readme_simplified_schematic", "label": "Simplified schematic redraw", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original 01_docs/System layout with sensors.png is deliberately not used."}, {"id": "05_twin_2d_readme_start_plant_button", "label": "Start plant button (cold start from ambient)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twin opens in shutdown; start only from shutdown, warm stack reset to 25 C first."}, {"id": "05_twin_2d_readme_trip_shutdown_rules_v24", "label": "Trip and shut-down rules v24", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Purge 16 min (plant 15-17), shut down at 9000 air off below 40 C, 10-min unloading window allows purge, Emergency stop button."}, {"id": "05_twin_2d_readme_emergency_stop", "label": "Emergency stop (everything off incl. air)", "file_type": "concept", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "05_twin_2d_readme_hs_cooling_slope", "label": "Plant cooling slope after hot standby (v25)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User asked to use POC slope; fitted on 5 free cool-downs, stack miss 12.2 -> 5.1 C; blends into heat balance below 300 C."}, {"id": "05_twin_2d_readme_linked_stages", "label": "Linked stages chain (v26)", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User: no direct jump into heat-up N2+H2, hot standby, fuel switch, part load; reached only from previous stage."}, {"id": "05_twin_2d_readme_sensor_panel", "label": "Sensor panel with 24 h per-sensor plots", "file_type": "rationale", "source_file": "05_twin_2d/README.md", "source_lo